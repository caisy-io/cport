{
  "name": "cport",
  "version": "0.0.1",
  "description": "import/export tool for caisy and other headless cms",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "ts-node src/index.ts",
    "gen": "rm -rf cport.db && rm -rf ./drizzle && yarn drizzle-kit generate:sqlite",
    "build": "tsc",
    "prepare": "husky",
    "asset": "ts-node src/lib/caisy/asset-files/asset.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\""
  },
  "keywords": [],
  "author": "caisy",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cli-progress": "^3.11.0",
    "@types/figlet": "^1.5.5",
    "@types/inquirer": "^9.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/json-stringify-safe": "^5.0.3",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.6",
    "@types/turndown": "^5.0.4",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "drizzle-kit": "^0.20.14",
    "eslint": "8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "3.2.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@caisy/rich-text-html-parser": "^0.1.2",
    "@caisy/sdk": "^1.3.2",
    "@contentful/rich-text-from-markdown": "^15.17.3",
    "@contentful/rich-text-html-renderer": "^16.3.5",
    "@contentful/rich-text-types": "^16.5.2",
    "better-sqlite3": "^9.4.3",
    "blurhash": "^2.0.5",
    "canvas": "^3.1.2",
    "chalk": "4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "cli-progress": "^3.12.0",
    "commander": "^10.0.0",
    "contentful": "^11.7.8",
    "contentful-export": "^7.21.68",
    "dotenv": "^16.0.3",
    "drizzle-orm": "^0.29.5",
    "drizzle-zod": "^0.5.1",
    "figlet": "^1.6.0",
    "inquirer": "^8.0.0",
    "js-yaml": "^4.1.0",
    "json-stringify-safe": "^5.0.1",
    "node-fetch": "^3.3.2",
    "p-limit": "^5.0.0",
    "pg": "^8.11.5",
    "ts-node": "^10.9.2",
    "turndown": "^7.2.0",
    "zod": "^3.22.4"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
